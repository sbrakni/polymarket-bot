# =============================================================================
# POLYMARKET ARBITRAGE BOT — Environment Variables Template
# Copy to .env and fill in your values
# =============================================================================

# --- Polymarket / Polygon ---
POLYMARKET_PRIVATE_KEY=0xyour_private_key_here
POLYMARKET_FUNDER_ADDRESS=0xyour_funder_address
POLYGON_RPC_URL=https://polygon-rpc.com

# --- Sports Data APIs ---
# TheOddsAPI: free tier available at https://the-odds-api.com
THEODDSAPI_KEY=your_theoddsapi_key
# Sportradar: premium, https://sportradar.com
SPORTRADAR_API_KEY=your_sportradar_key
# API-Football (rapid-api): https://rapidapi.com/api-sports/api/api-football
API_FOOTBALL_KEY=your_api_football_key

# --- Telegram Notifications ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- Risk Parameters ---
MAX_TOTAL_EXPOSURE=10000       # Max total capital at risk ($)
MAX_PER_MARKET=1000            # Max exposure per single market ($)
MAX_PER_TRADE=500              # Max size per individual trade ($)
DAILY_LOSS_LIMIT=500           # Auto-stop bot if daily loss exceeds this ($)
MIN_PROFIT_THRESHOLD=0.50      # Minimum profit per arbitrage ($)
KELLY_FRACTION=0.25            # Kelly Criterion fraction (0.25 = quarter Kelly)
MAX_OPEN_POSITIONS=50          # Maximum simultaneous open positions

# --- Bot Settings ---
DRY_RUN=true                   # true = simulate only, no real orders
LOG_LEVEL=INFO                 # DEBUG, INFO, WARNING, ERROR
SCAN_INTERVAL_MS=100           # Orderbook scan interval (milliseconds)
WS_RECONNECT_DELAY_S=5         # WebSocket reconnect delay (seconds)
DASHBOARD_PORT=8080            # Web dashboard port
DASHBOARD_HOST=0.0.0.0

# --- Strategy Toggles ---
ENABLE_BINARY_ARB=true         # Enable Module 2: Binary YES/NO arbitrage
ENABLE_REALITY_ARB=true        # Enable Module 1: Sports latency arbitrage
ENABLE_MULTI_HEDGE=true        # Enable Module 3: Multi-outcome hedging

# --- Binary Arbitrage Tuning ---
MIN_LIQUIDITY=1000             # Minimum market liquidity to consider ($)
MIN_BINARY_EDGE=0.02           # Minimum edge after fees (2% = $0.02 on a $1 contract)

# --- Reality Arbitrage Tuning ---
MIN_PROB_SHIFT=0.05            # Minimum probability shift to trigger trade (5%)
MAX_LATENCY_MS=500             # Abort if execution latency exceeds this

# --- Database (for position/trade history persistence) ---
DATABASE_URL=sqlite:///data/polymarket_bot.db
